# Local E-CHAKRA development needs no API key or cloud account.
# D1 and R2 are emulated locally; production bindings belong to the hosting platform.
# No Google Maps, Razorpay or ML integration is enabled in this prototype.
# These optional settings disable development-tool telemetry/network metadata requests.
CLOUDFLARE_CF_FETCH_ENABLED=false
WRANGLER_SEND_METRICS=false
